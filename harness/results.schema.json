{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moonglade harness results",
  "type": "object",
  "required": ["meta", "checks"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["started", "finished", "repo_sha", "fork_lock", "host", "full_run", "tier", "timing"],
      "properties": {
        "started": {"type": "string"},
        "finished": {"type": "string"},
        "repo_sha": {"type": "string"},
        "fork_lock": {"type": "object", "required": ["core_sha", "playerbots_sha"]},
        "host": {"type": "object", "required": ["platform", "machine"]},
        "full_run": {"type": "boolean"},
        "tier": {"enum": ["quick", "full", "slow", "gui", "backups"]},
        "force_clean": {"type": "boolean"},
        "timing": {"type": "object", "required": ["per_check_s", "checks_sum_s", "total_wall_s", "top10"],
                   "properties": {"per_check_s": {"type": "object"}, "checks_sum_s": {"type": "number"},
                                  "top10": {"type": "array"}}}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "duration_s", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["pass", "fail", "error", "skip"]},
          "duration_s": {"type": "number"},
          "evidence": {"type": "object", "minProperties": 1}
        }
      }
    }
  }
}
