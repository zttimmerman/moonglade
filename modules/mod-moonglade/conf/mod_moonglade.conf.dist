#
# mod-moonglade: Moonglade's single-player presentation (openspec/changes/seamless-experience).
#
[worldserver]

###################################################################################################
# MOONGLADE
#
#    Moonglade.QuietServerText
#        Description: Entering the world shows no message of the day and none of the login announcements that
#                     name a server, the core or the bot module (the core's motd packet and mod-playerbots' two
#                     login lines; see src/MoongladeQuiet.cpp). Re-read on a config reload.
#        Default:     1 - (Quiet)
#                     0 - (Stock: the motd and the announcements are sent)

Moonglade.QuietServerText = 1

#
#    Moonglade.Pause.Enable
#        Description: True pause (openspec/changes/true-pause, ADR-0013). Opening the game menu (the Moonglade add-on's
#                     "MGPAUSE" message) or `.moonglade pause on` stops the whole world until the menu closes; see
#                     src/MoongladePause.cpp. Needs the core patch patches/core/0003-world-pause.patch. Re-read on a
#                     config reload (turning it off resumes a paused world).
#        Default:     1 - (Pausing allowed)
#                     0 - (Pause requests do nothing)

Moonglade.Pause.Enable = 1

#
#    Moonglade.Saves.Enable
#        Description: Per-character saves (openspec/changes/front-menu-saves; src/MoongladeSaves.cpp): manual saves,
#                     one quicksave, autosaves at safe moments, and loading a save while the game runs. Saves stay
#                     off (reason in the log and `.moonglade save status`) when Moonglade.Saves.Dir is empty or
#                     CharacterDatabase.WorkerThreads isn't 1 (a load is ordered after every earlier write of the
#                     character by the character database's single FIFO worker).
#        Default:     1 - (Saves on)
#                     0 - (Saves off: requests are refused)

Moonglade.Saves.Enable = 1

#
#    Moonglade.Saves.Dir
#        Description: The save store: <Dir>/<ACCOUNT>/<character id>/<save id>/. The launcher renders it per lane
#                     (harness/hslib/config.py: <lane env>/saves; the player's is env/saves). Absolute path.
#        Default:     "" - (no store: saves off)

Moonglade.Saves.Dir = ""

#
#    Moonglade.Saves.AutoMinIntervalS
#        Description: At most one autosave per character in this many seconds (entering a rest area, taking a
#                     flight, arriving on a new map).
#        Default:     120

Moonglade.Saves.AutoMinIntervalS = 120

#
#    Moonglade.Saves.KeepAuto
#    Moonglade.Saves.KeepQuick
#    Moonglade.Saves.KeepBeforeLoad
#        Description: How many autosaves, quicksaves and "before loading" safety saves are kept per character (the
#                     oldest go first). Manual saves are never rotated.
#        Default:     5, 1, 3

Moonglade.Saves.KeepAuto = 5
Moonglade.Saves.KeepQuick = 1
Moonglade.Saves.KeepBeforeLoad = 3

#
#    Moonglade.Dungeons.FreshAfterClear
#        Description: Relaxed 5-player dungeon lockouts (openspec/changes/m4-dungeon-scaling; src/MoongladeDungeons.cpp).
#                     Entering a dungeon (normal or heroic) whose saved copy is finished (its last boss is dead) and
#                     has no player inside gives a fresh copy; an unfinished copy is kept, also when the party breaks
#                     up (dismissing companions). Logging in inside a dungeon changes nothing. Re-read on a config
#                     reload.
#        Default:     1 - (Fresh after clear, unfinished progress kept)
#                     0 - (Stock lockouts)

Moonglade.Dungeons.FreshAfterClear = 1

#
#    Moonglade.Dungeons.FreeStrandedCompanions
#        Description: A companion (bot) in another copy of a dungeon than its party leader's (for example one that
#                     logged out inside an older copy) is sent to its home point once a second, so a summon brings it
#                     to the leader instead of within the old copy. Re-read on a config reload.
#        Default:     1 - (On)
#                     0 - (Off: stock behaviour)

Moonglade.Dungeons.FreeStrandedCompanions = 1

#
###################################################################################################
