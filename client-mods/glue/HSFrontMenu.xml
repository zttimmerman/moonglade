<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Hearthstone front menu (openspec/changes/in-client-login, patch 0002). Our own file: it adds frames to the
	     stock login screen (AccountLoginUI) and wraps a few AccountLogin_* functions; nothing stock is replaced.
	     HSProfiles.lua is generated by the launcher at each start (inside the play client only). -->
	<Script file="HSProfiles.lua"/>
	<Script file="HSFrontMenu.lua"/>

	<Frame name="HSProfileRowTemplate" virtual="true" hidden="true">
		<Size x="270" y="28"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentName" inherits="GlueFontHighlight" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="8" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentPlay" inherits="GlueButtonSmallTemplateBlue">
				<Anchors>
					<Anchor point="RIGHT">
						<Offset>
							<AbsDimension x="-2" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						HSFrontMenu_RowClicked(self:GetParent());
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>

	<Button name="HSBackdropButtonTemplate" inherits="GlueButtonSmallTemplateBlue" virtual="true">
		<Scripts>
			<OnClick>
				HSFrontMenu_BackdropClicked(self);
			</OnClick>
		</Scripts>
	</Button>

	<!-- Continue (the last-used profile) where the stock Login button and edit boxes were -->
	<Frame name="HSMenu" parent="AccountLoginUI" hidden="true">
		<Size x="300" y="80"/>
		<Anchors>
			<Anchor point="BOTTOM">
				<Offset>
					<AbsDimension x="0" y="300"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="HSMenuWho" inherits="GlueFontNormal" text="">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="HSContinueButton" inherits="GlueButtonTemplateBlue">
				<Size x="260" y="52"/>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>
						HSFrontMenu_Continue();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>

	<!-- The other profiles, each with Play -->
	<Frame name="HSOthers" parent="AccountLoginUI" hidden="true">
		<Size x="290" y="60"/>
		<Anchors>
			<Anchor point="TOP" relativeTo="HSMenu" relativePoint="BOTTOM">
				<Offset>
					<AbsDimension x="0" y="-14"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Glues\Common\Glue-Tooltip-Border" tile="true">
			<EdgeSize>
				<AbsValue val="16"/>
			</EdgeSize>
			<TileSize>
				<AbsValue val="16"/>
			</TileSize>
			<BackgroundInsets>
				<AbsInset left="10" right="5" top="4" bottom="9"/>
			</BackgroundInsets>
		</Backdrop>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="HSOthersTitle" inherits="GlueFontNormalSmall" text="">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-12"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="HSProfileRow1" inherits="HSProfileRowTemplate" id="1"/>
			<Frame name="HSProfileRow2" inherits="HSProfileRowTemplate" id="2"/>
			<Frame name="HSProfileRow3" inherits="HSProfileRowTemplate" id="3"/>
			<Frame name="HSProfileRow4" inherits="HSProfileRowTemplate" id="4"/>
		</Frames>
	</Frame>

	<Frame name="HSBackdropPanel" parent="AccountLoginUI">
		<Size x="180" y="130"/>
		<Anchors>
			<Anchor point="BOTTOMLEFT">
				<Offset>
					<AbsDimension x="5" y="170"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="HSBackdropPanelLabel" inherits="GlueFontNormalSmall" text="">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="HSBackdropButton1" inherits="HSBackdropButtonTemplate" id="1">
				<Anchors>
					<Anchor point="TOP" relativeTo="HSBackdropPanelLabel" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="-4"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
			<Button name="HSBackdropButton2" inherits="HSBackdropButtonTemplate" id="2">
				<Anchors>
					<Anchor point="TOP" relativeTo="HSBackdropButton1" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="-2"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
			<Button name="HSBackdropButton3" inherits="HSBackdropButtonTemplate" id="3">
				<Anchors>
					<Anchor point="TOP" relativeTo="HSBackdropButton2" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="-2"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				HSFrontMenu_Init();
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- Test hook only (HS_TEST in HSFrontMenu.lua): character-list marker and scripted actions -->
	<Frame name="HSFrontMenuEvents" parent="GlueParent">
		<Scripts>
			<OnLoad>
				self:RegisterEvent("CHARACTER_LIST_UPDATE");
			</OnLoad>
			<OnEvent>
				HSFrontMenu_OnEvent(self, event);
			</OnEvent>
			<OnUpdate>
				HSFrontMenu_TestUpdate(self, elapsed);
			</OnUpdate>
		</Scripts>
	</Frame>
</Ui>
