<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Moonglade front menu (openspec/changes/in-client-login, patch 0002). Our own file: it adds frames to the
	     stock login screen (AccountLoginUI) and wraps a few AccountLogin_* functions; nothing stock is replaced.
	     HSProfiles.lua is generated by the launcher at each start (inside the play client only). -->
	<Script file="HSProfiles.lua"/>
	<Script file="HSSaves.lua"/>
	<Script file="HSFrontMenu.lua"/>
	<Script file="HSSeamless.lua"/>

	<Button name="HSMenuSlotTemplate" inherits="GlueButtonTemplateBlue" virtual="true">
		<Size x="240" y="40"/>
		<Scripts>
			<OnClick>
				HSFrontMenu_SlotClicked(self);
			</OnClick>
			<OnEnter>
				if ( self:GetID() == 1 ) then HSFrontMenu_ContinueHover(true); end
			</OnEnter>
			<OnLeave>
				if ( self:GetID() == 1 ) then HSFrontMenu_ContinueHover(false); end
			</OnLeave>
		</Scripts>
	</Button>

	<!-- The whole front menu: one centred column in the lower middle, over a subtle dark panel -->
	<Frame name="HSMenuPanel" parent="AccountLoginUI" hidden="true">
		<Size x="380" y="280"/>
		<Anchors>
			<Anchor point="BOTTOM">
				<Offset>
					<AbsDimension x="0" y="120"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Glues\Common\Glue-Tooltip-Border" tile="true">
			<EdgeSize>
				<AbsValue val="16"/>
			</EdgeSize>
			<TileSize>
				<AbsValue val="16"/>
			</TileSize>
			<BackgroundInsets>
				<AbsInset left="10" right="5" top="4" bottom="9"/>
			</BackgroundInsets>
		</Backdrop>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="HSMenuTitle" inherits="GlueFontNormal" text="">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-16"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
								<FontString name="HSMenuSelLabel" inherits="GlueFontNormal" text="" hidden="true"/>
				<FontString name="HSMenuText" inherits="GlueFontHighlightSmall" justifyH="CENTER" text="" hidden="true">
					<Size x="350" y="0"/>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="HSMenuSlot1" inherits="HSMenuSlotTemplate" id="1" hidden="true"/>
			<Button name="HSMenuSlot2" inherits="HSMenuSlotTemplate" id="2" hidden="true"/>
			<Button name="HSMenuSlot3" inherits="HSMenuSlotTemplate" id="3" hidden="true"/>
			<Button name="HSMenuSlot4" inherits="HSMenuSlotTemplate" id="4" hidden="true"/>
			<Button name="HSMenuSlot5" inherits="HSMenuSlotTemplate" id="5" hidden="true"/>
			<Button name="HSMenuSlot6" inherits="HSMenuSlotTemplate" id="6" hidden="true"/>
			<!-- Continue's context line (last-played character): part of Continue; clicking it presses Continue -->
			<Button name="HSContinueContext" hidden="true">
				<Size x="300" y="16"/>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="HSContinueContextText" inherits="GlueFontNormalSmall" setAllPoints="true" text=""/>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>
						HSFrontMenu_Activate(1);
					</OnClick>
					<OnEnter>
						HSFrontMenu_ContinueHover(true);
					</OnEnter>
					<OnLeave>
						HSFrontMenu_ContinueHover(false);
					</OnLeave>
				</Scripts>
			</Button>
			<Button name="HSArrowLeft" hidden="true">
				<Size x="32" y="32"/>
				<Scripts>
					<OnClick>
						HSFrontMenu_CycleBackdrop(-1);
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Up"/>
				<PushedTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Down"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Highlight" alphaMode="ADD"/>
			</Button>
			<Button name="HSArrowRight" hidden="true">
				<Size x="32" y="32"/>
				<Scripts>
					<OnClick>
						HSFrontMenu_CycleBackdrop(1);
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Up"/>
				<PushedTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Down"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Highlight" alphaMode="ADD"/>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				self:SetBackdropColor(0, 0, 0, 0.55);
				self:SetBackdropBorderColor(0.5, 0.5, 0.5, 0.6);
				HSFrontMenu_Init();
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- Test hook only (HS_TEST.marker): four solid squares, top right, that encode the menu's state in the client's
	     own screenshots (backdrop, music, main menu shown, Lua errors). Hidden unless a harness check asks for them. -->
	<Frame name="HSTestMarker" parent="GlueParent" frameStrata="FULLSCREEN_DIALOG" hidden="true">
		<Size x="200" y="93"/>
		<Anchors>
			<Anchor point="TOPRIGHT">
				<Offset>
					<AbsDimension x="-10" y="-10"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="HSTestMarkerBackdrop">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="HSTestMarkerMusic">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="53" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="HSTestMarkerMenu">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="106" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="HSTestMarkerErrors">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="159" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="HSTestLogText" inherits="GlueFontHighlightSmall" justifyH="RIGHT" justifyV="TOP" hidden="true">
					<Size x="600" y="0"/>
					<Anchors>
						<Anchor point="TOPRIGHT">
							<Offset>
								<AbsDimension x="0" y="-100"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- seamless-experience: second row, loading overlay / friendly error (HSFrontMenu_UpdateMarker) -->
				<Texture name="HSTestMarkerOverlay">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="0" y="-53"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<!-- saves-channel: control request state and the stock status dialog (HSFrontMenu_UpdateMarker) -->
				<Texture name="HSTestMarkerControl">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="53" y="-53"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="HSTestMarkerStock">
					<Size x="40" y="40"/>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="106" y="-53"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<!-- Test hook only (HS_TEST in HSFrontMenu.lua): character-list marker and scripted actions -->
	<Frame name="HSFrontMenuEvents" parent="GlueParent">
		<Scripts>
			<OnLoad>
				self:RegisterEvent("CHARACTER_LIST_UPDATE");
			</OnLoad>
			<OnEvent>
				HSFrontMenu_OnEvent(self, event);
			</OnEvent>
			<OnUpdate>
				HSFrontMenu_TestUpdate(self, elapsed);
			</OnUpdate>
		</Scripts>
	</Frame>

	<!-- seamless-experience (HSSeamless.lua): the loading overlay that replaces the stock connection dialogs. Fully
	     opaque, above the login and character screens and below the friendly error and the test marker. -->
	<Frame name="HSLoadingOverlay" parent="GlueParent" setAllPoints="true" frameStrata="FULLSCREEN" enableMouse="true" hidden="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="HSLoadingOverlayBg" setAllPoints="true">
					<Color r="0" g="0" b="0" a="1"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="HSLoadingOverlayLogo" file="Interface\Glues\Common\Glues-WoW-WotLKLogo">
					<Size x="256" y="128"/>
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-60"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="HSLoadingOverlayText" inherits="GlueFontNormalLarge" text="">
					<Anchors>
						<Anchor point="CENTER">
							<Offset>
								<AbsDimension x="0" y="20"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<Texture name="HSLoadingOverlayBarBg">
					<Size x="290" y="12"/>
					<Color r="0.25" g="0.2" b="0.1" a="0.6"/>
					<Anchors>
						<Anchor point="TOP" relativeTo="HSLoadingOverlayText" relativePoint="BOTTOM">
							<Offset>
								<AbsDimension x="0" y="-24"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="HSLoadingOverlayBarFill" file="Interface\Glues\LoadingBar\Loading-BarFill">
					<Size x="1" y="12"/>
					<Anchors>
						<Anchor point="LEFT" relativeTo="HSLoadingOverlayBarBg" relativePoint="LEFT"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="HSLoadingOverlayBack" inherits="GlueButtonSmallTemplate" text="" hidden="true">
				<Size x="150" y="32"/>
				<Anchors>
					<Anchor point="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="60"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						self:SetText(HS_FRIENDLY.back);
					</OnLoad>
					<OnClick>
						HSSeamless_OverlayBack();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>

	<!-- seamless-experience: the friendly error (Try again / Back to menu / Show details) -->
	<Frame name="HSErrorDialog" parent="GlueParent" setAllPoints="true" frameStrata="FULLSCREEN_DIALOG" enableMouse="true" hidden="true">
		<Frames>
			<Frame name="HSErrorDialogBox">
				<Size x="460" y="200"/>
				<Anchors>
					<Anchor point="CENTER"/>
				</Anchors>
				<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
					<BackgroundInsets>
						<AbsInset left="11" right="12" top="12" bottom="11"/>
					</BackgroundInsets>
					<TileSize>
						<AbsValue val="32"/>
					</TileSize>
					<EdgeSize>
						<AbsValue val="32"/>
					</EdgeSize>
				</Backdrop>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="HSErrorDialogTitle" inherits="GlueFontNormalLarge" text="">
							<Size x="400" y="0"/>
							<Anchors>
								<Anchor point="TOP">
									<Offset>
										<AbsDimension x="0" y="-24"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						<FontString name="HSErrorDialogText" inherits="GlueFontHighlight" text="">
							<Size x="400" y="0"/>
							<Anchors>
								<Anchor point="TOP" relativeTo="HSErrorDialogTitle" relativePoint="BOTTOM">
									<Offset>
										<AbsDimension x="0" y="-12"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						<FontString name="HSErrorDialogDetails" inherits="GlueFontHighlightSmall" justifyH="LEFT" text="" hidden="true">
							<Size x="400" y="0"/>
							<Anchors>
								<Anchor point="BOTTOM">
									<Offset>
										<AbsDimension x="0" y="20"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button name="HSErrorDialogRetry" inherits="GlueButtonTemplate" text="">
						<Size x="170" y="40"/>
						<Anchors>
							<Anchor point="TOPRIGHT" relativeTo="HSErrorDialogText" relativePoint="BOTTOM">
								<Offset>
									<AbsDimension x="-6" y="-18"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnLoad>
								self:SetText(HS_FRIENDLY.retry);
							</OnLoad>
							<OnClick>
								HSSeamless_Retry();
							</OnClick>
						</Scripts>
					</Button>
					<Button name="HSErrorDialogBack" inherits="GlueButtonTemplate" text="">
						<Size x="170" y="40"/>
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="HSErrorDialogText" relativePoint="BOTTOM">
								<Offset>
									<AbsDimension x="6" y="-18"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnLoad>
								self:SetText(HS_FRIENDLY.back);
							</OnLoad>
							<OnClick>
								HSSeamless_BackToMenu();
							</OnClick>
						</Scripts>
					</Button>
					<Button name="HSErrorDialogToggle">
						<Size x="160" y="20"/>
						<Anchors>
							<Anchor point="TOP" relativeTo="HSErrorDialogRetry" relativePoint="BOTTOMRIGHT">
								<Offset>
									<AbsDimension x="6" y="-8"/>
								</Offset>
							</Anchor>
						</Anchors>
						<NormalFont style="GlueFontNormalSmall"/>
						<HighlightFont style="GlueFontHighlightSmall"/>
						<Scripts>
							<OnClick>
								HSSeamless_ToggleDetails();
							</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</Frame>
		</Frames>
	</Frame>

	<!-- saves-channel (HSFrontMenu.lua, HSControl_*): the small overlay shown while a request to the launcher is
	     pending (instead of the stock connecting / error dialogs), and the request's clock and timeout -->
	<Frame name="HSControlOverlay" parent="GlueParent" setAllPoints="true" frameStrata="FULLSCREEN" enableMouse="true" hidden="true">
		<Frames>
			<Frame name="HSControlOverlayBox">
				<Size x="320" y="80"/>
				<Anchors>
					<Anchor point="CENTER"/>
				</Anchors>
				<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
					<BackgroundInsets>
						<AbsInset left="11" right="12" top="12" bottom="11"/>
					</BackgroundInsets>
					<TileSize>
						<AbsValue val="32"/>
					</TileSize>
					<EdgeSize>
						<AbsValue val="32"/>
					</EdgeSize>
				</Backdrop>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="HSControlOverlayText" inherits="GlueFontNormalLarge" text="">
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
	</Frame>
	<Frame name="HSControlFrame" parent="GlueParent">
		<Scripts>
			<OnUpdate>
				HSControl_OnUpdate(self, elapsed);
			</OnUpdate>
		</Scripts>
	</Frame>

	<!-- seamless-experience: the character-list event and the overlay's per-frame bookkeeping -->
	<Frame name="HSSeamlessEvents" parent="GlueParent">
		<Scripts>
			<OnLoad>
				self:RegisterEvent("CHARACTER_LIST_UPDATE");
			</OnLoad>
			<OnEvent>
				HSSeamless_OnEvent(self, event);
			</OnEvent>
			<OnUpdate>
				HSSeamless_OnUpdate(self, elapsed);
			</OnUpdate>
		</Scripts>
	</Frame>
</Ui>
