<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<!-- Hearthstone front menu (openspec/changes/in-client-login, patch 0002). Our own file: it adds frames to the
	     stock login screen (AccountLoginUI) and wraps a few AccountLogin_* functions; nothing stock is replaced.
	     HSProfiles.lua is generated by the launcher at each start (inside the play client only). -->
	<Script file="HSProfiles.lua"/>
	<Script file="HSFrontMenu.lua"/>

	<Button name="HSMenuSlotTemplate" inherits="GlueButtonTemplateBlue" virtual="true">
		<Size x="240" y="40"/>
		<Scripts>
			<OnClick>
				HSFrontMenu_SlotClicked(self);
			</OnClick>
		</Scripts>
	</Button>

	<!-- The whole front menu: one centred column in the lower middle, over a subtle dark panel -->
	<Frame name="HSMenuPanel" parent="AccountLoginUI" hidden="true">
		<Size x="300" y="280"/>
		<Anchors>
			<Anchor point="BOTTOM">
				<Offset>
					<AbsDimension x="0" y="120"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Glues\Common\Glue-Tooltip-Border" tile="true">
			<EdgeSize>
				<AbsValue val="16"/>
			</EdgeSize>
			<TileSize>
				<AbsValue val="16"/>
			</TileSize>
			<BackgroundInsets>
				<AbsInset left="10" right="5" top="4" bottom="9"/>
			</BackgroundInsets>
		</Backdrop>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="HSMenuTitle" inherits="GlueFontNormal" text="">
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-16"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="HSMenuSub" inherits="GlueFontNormalSmall" text=""/>
			</Layer>
		</Layers>
		<Frames>
			<Button name="HSMenuSlot1" inherits="HSMenuSlotTemplate" id="1" hidden="true"/>
			<Button name="HSMenuSlot2" inherits="HSMenuSlotTemplate" id="2" hidden="true"/>
			<Button name="HSMenuSlot3" inherits="HSMenuSlotTemplate" id="3" hidden="true"/>
			<Button name="HSMenuSlot4" inherits="HSMenuSlotTemplate" id="4" hidden="true"/>
			<Button name="HSMenuSlot5" inherits="HSMenuSlotTemplate" id="5" hidden="true"/>
			<Button name="HSMenuSlot6" inherits="HSMenuSlotTemplate" id="6" hidden="true"/>
			<Button name="HSArrowLeft" hidden="true">
				<Size x="32" y="32"/>
				<Scripts>
					<OnClick>
						HSFrontMenu_CycleBackdrop(-1);
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Up"/>
				<PushedTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Down"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-LeftArrow-Button-Highlight" alphaMode="ADD"/>
			</Button>
			<Button name="HSArrowRight" hidden="true">
				<Size x="32" y="32"/>
				<Scripts>
					<OnClick>
						HSFrontMenu_CycleBackdrop(1);
					</OnClick>
				</Scripts>
				<NormalTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Up"/>
				<PushedTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Down"/>
				<HighlightTexture file="Interface\Glues\Common\Glue-RightArrow-Button-Highlight" alphaMode="ADD"/>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				self:SetBackdropColor(0, 0, 0, 0.55);
				self:SetBackdropBorderColor(0.5, 0.5, 0.5, 0.6);
				HSFrontMenu_Init();
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- Test hook only (HS_TEST in HSFrontMenu.lua): character-list marker and scripted actions -->
	<Frame name="HSFrontMenuEvents" parent="GlueParent">
		<Scripts>
			<OnLoad>
				self:RegisterEvent("CHARACTER_LIST_UPDATE");
			</OnLoad>
			<OnEvent>
				HSFrontMenu_OnEvent(self, event);
			</OnEvent>
			<OnUpdate>
				HSFrontMenu_TestUpdate(self, elapsed);
			</OnUpdate>
		</Scripts>
	</Frame>
</Ui>
