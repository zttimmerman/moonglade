+ * with this program. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef __WORLDPAUSE_H
+#define __WORLDPAUSE_H
+
+#include "Define.h"
+#include "Duration.h"
+
+/// Moonglade (patches/core/0003-world-pause.patch, ADR-0013): a whole-world pause switch for a single-player server.
+/// While the world is paused, World::Update gives the simulation (maps, battlegrounds, LFG, outdoor PvP, world state,
+/// battlefields and the world/playerbot script hooks) zero elapsed time, Map::Update only processes its players'
+/// packets (no Player::Update), and GameTime stops; sessions, the database keep-alive, query callbacks and CLI/SOAP
+/// keep real time. The switch takes effect at the start of the next world tick. Policy (who may pause, rooting,
+/// resyncing the client) lives in a module. Kept out of World.h and GameTime.h so the patch rebuilds few files.
+namespace WorldPause
+{
+    /// Request a pause (true) or a resume (false). Any thread; applied at the start of the next world tick.
+    AC_GAME_API void SetPaused(bool paused);
+
+    /// The requested state.
+    AC_GAME_API bool IsPaused();
+
+    /// The state of the current world tick (sampled once by World::Update before anything else runs).
+    AC_GAME_API bool IsTickPaused();
+
+    /// World thread only: sample the requested state for this tick. Returns IsTickPaused().
+    bool BeginTick();
+
+    /// Total time the game clock has been stopped since the server started (the current pause included).
+    AC_GAME_API Milliseconds GetPausedTotal();
+}
+
+#endif
