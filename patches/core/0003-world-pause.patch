 #include "GameTime.h"
 #include "Timer.h"
+#include "WorldPause.h"
+#include <atomic>
+
+namespace WorldPause
+{
+    namespace
+    {
+        std::atomic<bool> Requested{false};
+        std::atomic<bool> TickPaused{false};
+        std::atomic<int64> PausedTotalMS{0};    // finished pauses only; the running one is added in GetPausedTotal()
+        std::atomic<int64> PauseStartMS{-1};    // GetTimeMS() when the running pause stopped the clock, -1 if none
+    }
+
+    void SetPaused(bool paused)
+    {
+        Requested.store(paused);
+    }
+
+    bool IsPaused()
+    {
+        return Requested.load();
+    }
+
+    bool IsTickPaused()
+    {
+        return TickPaused.load();
+    }
+
+    bool BeginTick()
+    {
+        bool paused = Requested.load();
+        TickPaused.store(paused);
+        return paused;
+    }
+
+    Milliseconds GetPausedTotal()
+    {
+        int64 start = PauseStartMS.load();
+        int64 running = start >= 0 ? GetTimeMS().count() - start : 0;
+        return Milliseconds(PausedTotalMS.load() + running);
+    }
+}
 
 namespace GameTime
 {
@@ -62,9 +104,26 @@ namespace GameTime
 
     void UpdateGameTimers()
     {
-        GameTime = GetEpochTime();
-        GameMSTime = GetTimeMS();
-        GameTimeSystemPoint = system_clock::now();
-        GameTimeSteadyPoint = steady_clock::now();
+        // Moonglade world pause (ADR-0013): while the tick is paused the game clock stands still; afterwards it runs
+        // behind the wall clock by the total paused time, so every GameTime-based timer resumes where it stopped.
+        int64 nowMS = GetTimeMS().count();
+        if (WorldPause::IsTickPaused())
+        {
+            if (WorldPause::PauseStartMS.load() < 0)
+                WorldPause::PauseStartMS.store(nowMS);
+            return;
+        }
+
+        if (int64 start = WorldPause::PauseStartMS.load(); start >= 0)
+        {
+            WorldPause::PausedTotalMS.fetch_add(nowMS - start);
+            WorldPause::PauseStartMS.store(-1);
+        }
+
+        Milliseconds offset(WorldPause::PausedTotalMS.load());
+        GameTimeSystemPoint = system_clock::now() - offset;
+        GameTime = duration_cast<Seconds>(GameTimeSystemPoint.time_since_epoch());
+        GameMSTime = Milliseconds(nowMS) - offset;
+        GameTimeSteadyPoint = steady_clock::now() - offset;
     }
 }
